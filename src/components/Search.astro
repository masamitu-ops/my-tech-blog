---
import 'pagefind/pagefind-ui.css';
---

<div id="search" class="my-8"></div>

<script>
  import { PagefindUI } from "@pagefind/default-ui";
  window.addEventListener('DOMContentLoaded', (event) => {
    new PagefindUI({ 
        element: "#search", 
        showSubResults: true,
        translations: {
            placeholder: "記事を検索...",
            clear_search: "消去",
            load_more: "さらに読み込む",
            search_label: "このサイトを検索",
            filters_label: "フィルタ",
            zero_results: "[search] に一致する記事は見つかりませんでした。",
            many_results: "[search] の検索結果 [count] 件",
            one_result: "[search] の検索結果 1 件",
            searching: "[search] を検索中..."
        }
    });
  });
</script>

<style is:global>
  /* ダークモードでも見やすいように色を調整 */
  :root {
    --pagefind-ui-primary: #3b82f6; 
    --pagefind-ui-text: #ffffff;
    --pagefind-ui-background: #1f2937;
    --pagefind-ui-border: #374151;
  }
</style>