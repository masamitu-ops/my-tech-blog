---
/**
 * PagefindのUIを表示せず、検索機能（API）のみを
 * ブラウザのグローバルオブジェクト（window.pagefind）にロードするコンポーネント。
 */
---

<script>
  /**
   * Pagefindはビルド後に生成されるため、通常のimportではビルドエラーになります。
   * そのため、実行時に非同期で読み込む手法（Dynamic Import）をとります。
   */
  async function loadPagefind() {
    try {
      // @ts-ignore
      const pagefind = await import("/pagefind/pagefind.js");
      // windowオブジェクトにセットして、news.astro側のscriptから叩けるようにする
      // @ts-ignore
      window.pagefind = pagefind;
    } catch (e) {
      console.error("Pagefind load error:", e);
    }
  }

  // ブラウザ上でのみ実行
  if (typeof window !== "undefined") {
    loadPagefind();
  }
</script>

<style>
  /* 何も表示しないため、スタイルは不要です */
</style>