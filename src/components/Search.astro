---
import '@pagefind/default-ui/css/ui.css';
---

<div id="search" class="my-8"></div>

---
/* 画面には何も表示せず、Pagefindのスクリプトだけを読み込む「黒子」コンポーネント */
---
<script>
  // Pagefindの検索ライブラリをブラウザに読み込ませる
  // @ts-ignore
  import("/pagefind/pagefind.js").then((res) => {
    window.pagefind = res;
  });
</script>

<style is:global>
  /* ダークモードでも見やすいように色を調整 */
  :root {
    --pagefind-ui-primary: #3b82f6; 
    --pagefind-ui-text: #ffffff;
    --pagefind-ui-background: #1f2937;
    --pagefind-ui-border: #374151;
  }
</style>