---
import Layout from '../layouts/BlogPost.astro';
// 1. Searchコンポーネントをインポート
import Search from '../components/Search.astro';

// Notion API設定
const apiKey = import.meta.env.NOTION_API_KEY;
const databaseId = import.meta.env.NOTION_DATABASE_ID;

let newsItems = [];
let allTags = [];

try {
  let hasMore = true;
  let cursor = undefined;

  while (hasMore) {
    const response = await fetch(`https://api.notion.com/v1/databases/${databaseId}/query`, {
      method: 'POST',
      headers: {
        'Authorization': `Bearer ${apiKey}`,
        'Notion-Version': '2022-06-28',
        'Content-Type': 'application/json',
      },
      body: JSON.stringify({
        page_size: 100, 
        start_cursor: cursor,
        sorts: [{ property: '情報の鮮度', direction: 'descending' }],
      }),
    });

    const data = await response.json();
    if (!response.ok) throw new Error(data.message);

    const fetchedItems = data.results.map((page: any) => {
      const dateStr = page.properties['情報の鮮度']?.date?.start || '';
      const publishedDate = new Date(dateStr);
      const diffDays = (new Date().getTime() - publishedDate.getTime()) / (1000 * 60 * 60 * 24);
      
      return {
        title: page.properties['タイトル']?.title[0]?.plain_text || 'No Title',
        url: page.properties['Source URL']?.url || null,
        tags: page.properties['関連用語']?.multi_select.map((tag: any) => tag.name) || [],
        summary: page.properties['要約']?.rich_text[0]?.plain_text || '',
        date: dateStr.split('T')[0].replace(/-/g, '/'),
        isNew: diffDays <= 3,
        isImportant: page.properties['重要']?.checkbox || false,
      };
    });

    newsItems = [...newsItems, ...fetchedItems];
    hasMore = data.has_more;
    cursor = data.next_cursor;
  }

  allTags = [...new Set(newsItems.flatMap(item => item.tags))].sort();
} catch (e) {
  console.error("Notion API Error:", e);
}
---

<Layout title="IT News Library">
  <div class="news-container">
    <header class="page-header">
      <h1 class="text-center text-3xl font-bold mb-6">IT News Library</h1>
      
      <div class="search-section-wrapper mb-12">
        <Search />
      </div>

      <div class="selected-tags-area" id="selected-tags-container"></div>
    </header>

    <div class="content-layout">
      <main class="news-feed" data-pagefind-body>
        <div id="news-grid">
          {newsItems.map((item) => (
            <article class="modern-card" data-title={item.title} data-tags={item.tags.join(',')} data-important={item.isImportant ? "true" : "false"}>
              <div class="card-top">
                <div class="badge-row">
                  {item.isImportant && <span class="badge badge-star">★ Important</span>}
                  {item.isNew && <span class="badge badge-new">New</span>}
                </div>
                <time class="post-date">{item.date}</time>
              </div>

              <div class="card-body">
                {item.url && (
                  <div class="site-icon">
                    <img src={`https://www.google.com/s2/favicons?domain=${item.url}&sz=64`} alt="" />
                  </div>
                )}
                <div class="card-main-text">
                  <h2 class="card-title">{item.title}</h2>
                  <div class="card-tags">
                    {item.tags.map(tag => <span class="mini-tag">{tag}</span>)}
                  </div>
                  <p class="card-desc">{item.summary}</p>
                  {item.url && <a href={item.url} target="_blank" rel="noopener noreferrer" class="card-action">Visit Source →</a>}
                </div>
              </div>
            </article>
          ))}
        </div>
        <div id="no-results" class="no-results-msg" style="display: none;">
          <p class="msg-icon">∅</p>
          <p>条件に一致する記事が見つかりませんでした。</p>
        </div>
      </main>

      <aside class="sidebar" data-pagefind-ignore> <div class="sidebar-card">
          <div class="sidebar-header">
            <h3>Filter Tags</h3>
            <button id="clear-filters" class="text-btn">Clear All</button>
          </div>
          <div class="tag-scroll-area">
            <div id="tag-cloud" class="tag-cloud">
              {allTags.map(tag => (
                <button class="tag-btn" data-tag={tag}>{tag}</button>
              ))}
            </div>
          </div>
        </div>
      </aside>
    </div>
  </div>
</Layout>

<style>
  /* 既存のスタイルを維持 */
  .news-container { max-width: 1140px; margin: 0 auto; padding: 2rem 1rem; }
  .search-section-wrapper { max-width: 700px; margin: 0 auto; }
  /* ... (以下、元のスタイルをそのまま適用) ... */
  .page-header { margin-bottom: 2rem; }
  .selected-tags-area { display: flex; flex-wrap: wrap; gap: 8px; justify-content: center; min-height: 32px; margin-top: 1rem; }
  .content-layout { display: grid; grid-template-columns: 1fr 300px; gap: 2.5rem; }
  .modern-card { background: #fff; border: 1px solid #f0f0f0; border-radius: 16px; padding: 1.8rem; margin-bottom: 1.5rem; transition: all 0.3s ease; }
  /* 省略：元のCSSを継続して使用してください */
</style>

<script>
  // タグフィルタリングのロジックはPagefindとは別に「現在の画面内での絞り込み」として残しておきます
  let activeTags = new Set();
  const cards = document.querySelectorAll('.modern-card');
  const tagBtns = document.querySelectorAll('.tag-btn');
  const selectedTagsContainer = document.getElementById('selected-tags-container');

  const updateList = () => {
    let visibleCount = 0;
    cards.forEach(card => {
      const el = card as HTMLElement;
      const cardTags = el.dataset.tags?.split(',') || [];
      const matchesTags = activeTags.size === 0 || Array.from(activeTags).every(t => cardTags.includes(t as string));

      if (matchesTags) {
        el.style.display = "block";
        visibleCount++;
      } else {
        el.style.display = "none";
      }
    });
    renderSelectedTags();
  };

  const renderSelectedTags = () => {
    if (!selectedTagsContainer) return;
    selectedTagsContainer.innerHTML = '';
    activeTags.forEach(tag => {
      const badge = document.createElement('div');
      badge.className = 'active-tag-badge';
      badge.innerHTML = `<span>${tag}</span><span style="font-size:1.1rem; opacity:0.8;">×</span>`;
      badge.onclick = () => {
        const targetBtn = document.querySelector(`.tag-btn[data-tag="${tag}"]`);
        if (targetBtn) (targetBtn as HTMLElement).click();
      };
      selectedTagsContainer.appendChild(badge);
    });
  };

  tagBtns.forEach(btn => {
    btn.addEventListener('click', () => {
      const tag = btn.getAttribute('data-tag');
      if (!tag) return;
      if (activeTags.has(tag)) {
        activeTags.delete(tag);
        btn.classList.remove('active');
      } else {
        activeTags.add(tag);
        btn.classList.add('active');
      }
      updateList();
    });
  });

  document.getElementById('clear-filters')?.addEventListener('click', () => {
    activeTags.clear();
    tagBtns.forEach(b => b.classList.remove('active'));
    updateList();
  });
</script>