---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

// 認証情報
const NOTION_TOKEN = "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";
const DATABASE_ID = "2dab02251e65809c9b01e2c8659ae405";

let newsItems = [];
let errorDetail = "";

try {
  const response = await fetch(`https://api.notion.com/v1/databases/${DATABASE_ID}/query`, {
    method: 'POST',
    headers: {
      'Authorization': `Bearer ${NOTION_TOKEN}`,
      'Notion-Version': '2022-06-28',
      'Content-Type': 'application/json',
    },
    body: JSON.stringify({
      sorts: [{ property: '情報の鮮度', direction: 'descending' }],
      page_size: 50, // 10件から50件に増やして「過去の記事」も取得
    }),
  });

  const data = await response.json();
  if (!response.ok) throw new Error(data.message || "Communication failed");

  newsItems = data.results.map((page: any) => {
    const p = page.properties;
    return {
      title: p.タイトル?.title?.[0]?.plain_text || "No Title",
      summary: p.要約?.rich_text?.[0]?.plain_text || "要約なし",
      date: p.情報の鮮度?.date?.start 
            ? new Date(p.情報の鮮度.date.start).toLocaleDateString('ja-JP') 
            : "不明",
      tags: p.関連用語?.multi_select?.map((tag: any) => tag.name) || [],
      url: page.url 
    };
  });
} catch (e: any) {
  errorDetail = e.message;
}
---

<html lang="ja">
	<head>
		<BaseHead title="IT News Library" description="Searchable IT News Archive" />
		<style>
			main { width: 960px; max-width: calc(100% - 2em); margin: auto; padding: 1em; }
			
			/* 検索窓のスタイル */
			.search-container { margin-bottom: 2rem; position: sticky; top: 10px; z-index: 100; }
			#newsSearch { 
				width: 100%; padding: 12px 20px; border-radius: 30px; 
				border: 2px solid #0076ff; font-size: 1rem; outline: none;
				box-shadow: 0 4px 12px rgba(0,118,255,0.15);
			}

			.card { background: white; padding: 1.5rem; border-radius: 12px; border: 1px solid #e1e4e8; margin-bottom: 2rem; }
			.tag-container { display: flex; flex-wrap: wrap; gap: 6px; margin-bottom: 1rem; }
			.tag { background: #eef6ff; color: #0076ff; padding: 3px 12px; border-radius: 20px; font-size: 0.75rem; font-weight: 600; }
			.summary { background: #fcfcfc; padding: 1.2rem; border-left: 4px solid #0076ff; margin: 1.2rem 0; white-space: pre-wrap; line-height: 1.7; }
			
			/* 検索で見つからない時の表示 */
			#noResult { display: none; text-align: center; padding: 3rem; color: #666; }
		</style>
	</head>
	<body>
		<Header />
		<main>
			<h1>ITニュース ライブラリ</h1>

			<div class="search-container">
				<input type="text" id="newsSearch" placeholder="キーワードで記事を検索（例: Bedrock, Lambda）..." />
			</div>

			<div id="noResult">一致する記事が見つかりませんでした。</div>

			<div id="newsGrid">
				{newsItems.map((item) => (
					<div class="card news-card" data-search-text={item.title + item.summary + item.tags.join(' ')}>
						<div class="meta">📅 {item.date}</div>
						<div class="tag-container">
							{item.tags.map((tag) => <span class="tag">{tag}</span>)}
						</div>
						<h2>{item.title}</h2>
						<div class="summary">{item.summary}</div>
						<a href={item.url} target="_blank" style="color:#0076ff; font-size:0.9rem; font-weight:bold;">ソースを確認する →</a>
					</div>
				))}
			</div>
		</main>
		<Footer />

		<script>
			const searchInput = document.getElementById('newsSearch');
			const cards = document.querySelectorAll('.news-card');
			const noResult = document.getElementById('noResult');

			searchInput.addEventListener('input', (e) => {
				const query = e.target.value.toLowerCase();
				let hasVisibleCard = false;

				cards.forEach(card => {
					const text = card.getAttribute('data-search-text').toLowerCase();
					if (text.includes(query)) {
						card.style.display = 'block';
						hasVisibleCard = true;
					} else {
						card.style.display = 'none';
					}
				});

				noResult.style.display = hasVisibleCard ? 'none' : 'block';
			});
		</script>
	</body>
</html>